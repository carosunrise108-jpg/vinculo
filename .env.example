# Copia este archivo como .env.local y completa los valores REALES ahí (nunca en este
# archivo ni en el chat). .env.local está en .gitignore — no se sube al repositorio.

# Supabase → Project Settings → API (pública)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role (SECRETA — solo se usa en el
# servidor, nunca en código que corre en el navegador). Se agrega en la Sesión 6
# cuando se conecte el webhook de Hotmart.
# SUPABASE_SERVICE_ROLE_KEY=
