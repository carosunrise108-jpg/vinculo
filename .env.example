# Copia este archivo como .env.local y completa los valores REALES ahí (nunca en este
# archivo ni en el chat). .env.local está en .gitignore — no se sube al repositorio.

# Supabase → Project Settings → API (pública)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API (SECRETAS — solo se usan en el servidor, nunca en
# código que corre en el navegador). Las usa el webhook de Hotmart.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Links de pago de cada plan en Hotmart (PÚBLICOS — van a Vercel como variable normal).
# Mientras no existan, el botón del paywall lleva a /login.
# NEXT_PUBLIC_HOTMART_CHECKOUT_ANUAL=
# NEXT_PUBLIC_HOTMART_CHECKOUT_MENSUAL=

# Hotmart → Herramientas → Webhook → pestaña Autenticación (SECRETA — solo servidor).
# Sin esta variable, el webhook rechaza TODAS las peticiones (fail-secure).
# HOTMART_HOTTOK=
